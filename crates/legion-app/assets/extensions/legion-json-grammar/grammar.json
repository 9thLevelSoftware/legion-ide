{
  "name": "legion_json_grammar",
  "word": "identifier",
  "rules": {
    "document": {
      "type": "SYMBOL",
      "name": "value"
    },
    "value": {
      "type": "CHOICE",
      "members": [
        { "type": "SYMBOL", "name": "object" },
        { "type": "SYMBOL", "name": "array" },
        { "type": "SYMBOL", "name": "string" },
        { "type": "SYMBOL", "name": "number" },
        { "type": "STRING", "value": "true" },
        { "type": "STRING", "value": "false" },
        { "type": "STRING", "value": "null" }
      ]
    },
    "object": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "{" },
        { "type": "SYMBOL", "name": "pair_list" },
        { "type": "STRING", "value": "}" }
      ]
    },
    "pair_list": {
      "type": "REPEAT",
      "content": { "type": "SYMBOL", "name": "pair" }
    },
    "pair": {
      "type": "SEQ",
      "members": [
        { "type": "SYMBOL", "name": "string" },
        { "type": "STRING", "value": ":" },
        { "type": "SYMBOL", "name": "value" }
      ]
    },
    "array": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "[" },
        { "type": "REPEAT", "content": { "type": "SYMBOL", "name": "value" } },
        { "type": "STRING", "value": "]" }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "number": {
      "type": "PATTERN",
      "value": "-?[0-9]+(\\.[0-9]+)?"
    }
  },
  "extras": [
    { "type": "PATTERN", "value": "\\s" }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
